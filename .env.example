# Copy to .env and fill in secrets. Never commit .env.
# Do not set DATABASE_URL, ADMIN_EMAIL, GRPC_ADDR, WHITELIST_JSON, COOKIE_NAME, or SESSION_TTL.

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production:
GOOGLE_REDIRECT_URL=https://filenkov.store/oauth/google/callback
# Local (host Caddy on :80):
# GOOGLE_REDIRECT_URL=http://localhost/oauth/google/callback

# --- JWT (shared by API and Gateway; never sent to User-Service) ---
# >=32 random bytes
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# User-Service on compose network user_network (unpublished :8000)
USER_SERVICE_URL=http://user_service:8000

# --- Cookies ---
COOKIE_DOMAIN=.filenkov.store
PUBLIC_ORIGIN=https://filenkov.store

# Local HTTP (Secure=false cookie, allow http://localhost and http://127.0.0.1 return_to):
# AUTH_DEV_HTTP=true
# COOKIE_DOMAIN=
# PUBLIC_ORIGIN=http://localhost
AUTH_DEV_HTTP=false

# --- Listen (API container :8000, unpublished) ---
HTTP_ADDR=:8000

# --- Redis (rejected_cache + OAuth state + rate limits + companion session:{sid}) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Owl chat (LiteLLM proxy on llm_network) ---
# OpenAI-compatible base URL. LiteLLM keeps the real provider keys, so "dummy"
# is the right value here unless that proxy enforces virtual keys.
LLM_HOST=...
LLM_API_KEY=dummy
# Must be a model name your LiteLLM proxy actually serves — it 400s on any other.
LLM_MODEL=gpt-4o-mini
# "none" tells a reasoning model not to think before a two-sentence answer.
# Set it empty (LLM_REASONING_EFFORT=) if your proxy rejects the field outright;
# inline <think> blocks are stripped from the answer either way.
LLM_REASONING_EFFORT=none

# --- MLflow tracing (optional, independent of generation) ---
# Base URL of the MLflow tracking server; the API posts OTLP/HTTP spans to
# {MLFLOW_TRACING_ENDPOINT}/v1/traces. Needs MLflow >= 3.6 on a SQL backend.
# Unset disables tracing and changes nothing else.
# MLFLOW_TRACING_ENDPOINT=http://mlflow:5000
# The experiment ("project") traces land in — the numeric id, not its name.
# MLFLOW_EXPERIMENT_ID=

# Compose publishes only 127.0.0.1:8083 on the gateway.
GATEWAY_CONFIG=deploy/gateway.yaml
