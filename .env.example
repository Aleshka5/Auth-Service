# Copy to .env and fill in secrets. Never commit .env.

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production:
GOOGLE_REDIRECT_URL=https://filenkov.store/oauth/google/callback
# Local (host Caddy on :80):
# GOOGLE_REDIRECT_URL=http://localhost/oauth/google/callback

# First insert of this Google email gets roles=ADMIN. Later logins do not re-force it.
ADMIN_EMAIL=you@gmail.com

# --- Session cookie ---
COOKIE_DOMAIN=.filenkov.store
COOKIE_NAME=auth_session
SESSION_TTL=168h
PUBLIC_ORIGIN=https://filenkov.store

# Local HTTP (Secure=false cookie, allow http://localhost and http://127.0.0.1 return_to):
# AUTH_DEV_HTTP=true
# COOKIE_DOMAIN=
# PUBLIC_ORIGIN=http://localhost
AUTH_DEV_HTTP=false

# --- Listen (container defaults; override for `go run`) ---
HTTP_ADDR=:8080
GRPC_ADDR=:9090

# --- Postgres / Redis (compose overrides hostnames to postgres/redis) ---
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=auth
DATABASE_URL=postgres://auth:auth@127.0.0.1:5432/auth?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
MIGRATIONS_PATH=migrations

# Optional extra whitelist hosts (merged onto the built-in v1 map):
# WHITELIST_JSON={"app.filenkov.store":["name","roles"]}

# Host ports published on 127.0.0.1 for the existing Caddy reverse proxy.
API_HTTP_PORT=8082
WEB_HTTP_PORT=8081
